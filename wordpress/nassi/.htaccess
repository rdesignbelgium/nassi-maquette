# Assets versionnés : /assets/v1.2.3/js/main.js → /assets/js/main.js (contourne les caches Varnish/CDN lors des mises à jour)
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteRule ^assets/v[0-9.]+/style\.css$ style.css [L]
RewriteRule ^assets/v[0-9.]+/(.+)$ assets/$1 [L]
</IfModule>
<IfModule mod_expires.c>
ExpiresActive On
ExpiresByType text/css "access plus 1 day"
ExpiresByType text/javascript "access plus 1 day"
ExpiresByType application/javascript "access plus 1 day"
</IfModule>
